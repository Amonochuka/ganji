# Ganji backend environment. Copy to `.env` and fill in real values.
#   cp .env.example .env
# Never commit `.env` (it is gitignored).

# --- Required ---
PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/ganji?sslmode=disable
JWT_SECRET=change-me-access-token-secret
JWT_REFRESH_SECRET=change-me-refresh-token-secret

# --- LNbits / Lightning (required for escrow) ---
LNBITS_URL=http://localhost:5000
# Invoice key: creates hold invoices.
LNBITS_API_KEY=change-me-lnbits-invoice-key
# Admin key: required for the money moves (settle / cancel / payout).
LNBITS_ADMIN_KEY=change-me-lnbits-admin-key
# Shared webhook secret; required. Local-only bypass: ALLOW_INSECURE_WEBHOOKS=true.
LNBITS_WEBHOOK_SECRET=change-me-lnbits-webhook-secret
ALLOW_INSECURE_WEBHOOKS=false
# Public URL LNbits should POST webhooks to.
WEBHOOK_URL=http://localhost:8080/webhooks/lnbits
# Optional: direct Es LND REST lookup confirms accepted hold invoices. Set all
# three values or none. Paths are local files; never commit certificate or
# macaroon contents.
LND_REST_URL=https://localhost:8082
LND_REST_CERT_PATH=/absolute/path/to/.polar/networks/3/volumes/lnd/Es/tls.cert
LND_REST_MACAROON_PATH=/absolute/path/to/.polar/networks/3/volumes/lnd/Es/data/chain/bitcoin/regtest/admin.macaroon
# Hold invoice lifetime (seconds). Default 30 days.
LNBITS_HOLD_INVOICE_EXPIRY_SECONDS=2592000
# Background hold-expiry sweep cadence (seconds). Default 6 hours.
LNBITS_HOLD_SWEEP_INTERVAL_SECONDS=21600

# AES-GCM preimage encryption key (32+ chars). Required in production.
PREIMAGE_ENCRYPTION_KEY=change-me-preimage-encryption-key

# --- Storage ---
STORAGE_PATH=./uploads
MAX_UPLOAD_BYTES=10485760

# --- Misc ---
FRONTEND_URLS=http://localhost:3000
# Add every browser-visible origin here when using a LAN IP/hostname, e.g.
# FRONTEND_URLS=http://localhost:3000,http://192.168.1.149:3000
# Dev only: allow any private-LAN http://host:3000 origin so Wi-Fi IP changes
# do not require editing FRONTEND_URLS. Never enable in production.
CORS_ALLOW_PRIVATE_LAN=false
# Dev only: exact caller-supplied LNbits wallet origins allowed through the SSRF
# guard. Keep both local wallets usable from the Generate/Fund dialogs. Production
# refuses to start if this is set.
DEV_ALLOWED_WALLET_URLS=http://localhost:5001,http://localhost:5002
# Comma-separated emails promoted to arbitration operators at boot.
OPERATOR_EMAILS=

# --- OpenTimestamps (blockchain anchoring of CV entries) ---
# Esplora API endpoint for full Bitcoin block-header verification of OTS
# proofs. Every /cv/:slug/verify/:entryID call that carries a confirmed proof
# will ask this endpoint to confirm the proof's block really exists.
#   - Public example: https://blockstream.info/api (free, rate-limited)
#   - Any esplora-compatible service works (e.g. your own mempool.space:
#     https://mempool.space/api)
# Leave empty (OTS_ESPLORA_URL=) to verify proofs OFFLINE only — the stored
# .ots file is still parsed and replayed, but Ganji will not confirm the
# attested block against the real blockchain.
OTS_ESPLORA_URL=https://blockstream.info/api
# Timeout for each esplora request (seconds).
OTS_ESPLORA_TIMEOUT_SECONDS=10
# Cadence of the background proof-upgrade worker (seconds). Default 6 hours.
OTS_UPGRADE_INTERVAL_SECONDS=21600

# --- Email notifications (SMTP). Leave SMTP_HOST/SMTP_USER empty to disable. ---
# Notifications (payment received, released, refunded, disputed) are emitted
# only when both SMTP_HOST and SMTP_USER are set. Encryption is one of
# starttls (default), tls (implicit), none.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ganji.local
SMTP_ENCRYPTION=starttls
