# Ganji backend environment. Copy to `.env` and fill in real values.
#   cp .env.example .env
# Never commit `.env` (it is gitignored).

# --- Required ---
PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/ganji?sslmode=disable
JWT_SECRET=change-me-access-token-secret
JWT_REFRESH_SECRET=change-me-refresh-token-secret

# --- LNbits / Lightning (required for escrow) ---
LNBITS_URL=http://localhost:5000
# Invoice key: creates hold invoices.
LNBITS_API_KEY=change-me-lnbits-invoice-key
# Admin key: required for the money moves (settle / cancel / payout).
LNBITS_ADMIN_KEY=change-me-lnbits-admin-key
# Shared webhook secret; leave empty to skip signature verification.
LNBITS_WEBHOOK_SECRET=
# Public URL LNbits should POST webhooks to.
WEBHOOK_URL=http://localhost:8080/webhooks/lnbits
# Hold invoice lifetime (seconds). Default 30 days.
LNBITS_HOLD_INVOICE_EXPIRY_SECONDS=2592000
# Background hold-expiry sweep cadence (seconds). Default 6 hours.
LNBITS_HOLD_SWEEP_INTERVAL_SECONDS=21600

# --- Storage ---
STORAGE_PATH=./uploads
MAX_UPLOAD_BYTES=10485760

# --- Misc ---
FRONTEND_URL=http://localhost:3000
# Comma-separated emails promoted to arbitration operators at boot.
OPERATOR_EMAILS=

# --- Email notifications (SMTP). Leave SMTP_HOST/SMTP_USER empty to disable. ---
# Notifications (payment received, released, refunded, disputed) are emitted
# only when both SMTP_HOST and SMTP_USER are set. Encryption is one of
# starttls (default), tls (implicit), none.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ganji.local
SMTP_ENCRYPTION=starttls
