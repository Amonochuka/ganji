# Ganji frontend environment. Copy to `.env.local`:
#   cp .env.example .env.local

# Base URL of the running Go backend.
NEXT_PUBLIC_API_URL=http://localhost:8080

# WebSocket URL for real-time deal updates (backend WebSocket server is not
# built yet; safe to leave unset for now).
NEXT_PUBLIC_WS_URL=ws://localhost:8080
